# Google AI (Gemini) API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase (required for /admin/login and template storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App secret used by mobile/web clients (x-app-secret)
# Generate a secure random string (minimum 32 chars recommended)
APP_SECRET=change-me-very-long-random-app-secret

# Admin key used for admin-only endpoints (x-admin-key)
# Must be different from APP_SECRET
ADMIN_KEY=change-me-very-long-random-admin-key

# Comma-separated origin allowlist for CORS middleware
# Example: https://breviai.app,https://app.breviai.com
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Development fallback switch
# Keep "false" in production
ALLOW_INSECURE_DEV_AUTH=false

# Optional: Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Slack OAuth Credentials
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

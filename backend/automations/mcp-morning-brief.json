{
    "id": "mcp-morning-brief",
    "name": "☀️ Akıllı Sabah Brifingi",
    "description": "Her iş günü sabah 09:00'da çalışır. Takvim, mail, hava durumu, döviz kuru kontrol eder. WhatsApp özet + sesli bildirim.",
    "schedule": "0 9 * * 1-5",
    "enabled": true,
    "action": {
        "type": "multi_mcp",
        "steps": [
            {
                "id": "step-1-calendar",
                "name": "📅 Bugünkü Etkinlikler",
                "tool": "breviai.google.calendar_list",
                "nodeType": "CALENDAR_READ",
                "args": {
                    "accessToken": "{{GOOGLE_ACCESS_TOKEN}}",
                    "calendarId": "primary",
                    "maxResults": 10
                }
            },
            {
                "id": "step-2-mail",
                "name": "📧 Okunmamış Mailler",
                "tool": "breviai.google.gmail_read",
                "nodeType": "GMAIL_READ",
                "args": {
                    "accessToken": "{{GOOGLE_ACCESS_TOKEN}}",
                    "query": "is:unread",
                    "maxResults": 5
                }
            },
            {
                "id": "step-3-weather",
                "name": "☁️ Hava Durumu",
                "tool": "breviai.web_search",
                "nodeType": "WEB_SEARCH",
                "args": {
                    "query": "İstanbul hava durumu bugün",
                    "variableName": "weather"
                }
            },
            {
                "id": "step-4-currency",
                "name": "💱 Döviz Kuru",
                "tool": "breviai.web_search",
                "nodeType": "WEB_SEARCH",
                "args": {
                    "query": "dolar euro TL kuru bugün",
                    "variableName": "currency"
                }
            },
            {
                "id": "step-5-whatsapp",
                "name": "📱 WhatsApp Özet",
                "tool": "whatsapp_send",
                "nodeType": "WHATSAPP_SEND",
                "args": {
                    "phone": "{{WHATSAPP_PHONE}}",
                    "message": "☀️ *Günaydın! Sabah Brifingin Hazır:*\n\n📅 *Bugünkü Etkinlikler:*\n{{events}}\n\n📧 *Okunmamış Mailler:*\n{{emails}}\n\n☁️ *Hava Durumu:*\n{{weather}}\n\n💱 *Döviz Kuru:*\n{{currency}}\n\n_BreviAI Sabah Brifingi • {{_date}} {{_time}}_",
                    "mode": "backend"
                }
            },
            {
                "id": "step-6-voice",
                "name": "🔊 Sesli Brifing",
                "tool": "speak_text",
                "nodeType": "SPEAK_TEXT",
                "args": {
                    "text": "Günaydın! İşte sabah brifingin. Bugün {{events.count}} toplantın ve {{emails.count}} okunmamış mailin var. Hava durumu: {{weather}}. Döviz: {{currency}}. İyi günler!",
                    "language": "tr-TR"
                }
            }
        ]
    },
    "config_guide": {
        "GOOGLE_ACCESS_TOKEN": "Ayarlar > Google ile Giriş Yap'tan alınan OAuth token",
        "WHATSAPP_PHONE": "WhatsApp numarası (örn: 905551234567)"
    }
}
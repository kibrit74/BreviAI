{
    "id": "template_smart_call_recorder",
    "name": "Akıllı Arama Kaydedici",
    "description": "Arama bittiğinde otomatik olarak kayıt dosyasını bulur, metne çevirir, özetler ve hafızaya kaydeder. Cube ACR veya benzeri bir uygulama ile hoparlörsüz çalışır.",
    "isActive": true,
    "nodes": [
        {
            "id": "trigger_call_end",
            "type": "CALL_TRIGGER",
            "label": "Arama Bitti",
            "config": {
                "states": [
                    "Disconnected"
                ],
                "variableName": "callerInfo"
            },
            "position": {
                "x": 100,
                "y": 50
            }
        },
        {
            "id": "delay_wait",
            "type": "DELAY",
            "label": "Dosya Yazılmasını Bekle",
            "config": {
                "duration": 10,
                "unit": "seconds"
            },
            "position": {
                "x": 100,
                "y": 180
            }
        },
        {
            "id": "find_recording",
            "type": "FIND_CALL_RECORDING",
            "label": "Kayıt Dosyasını Bul",
            "config": {
                "variableName": "callRecording",
                "maxAgeSeconds": 3600
            },
            "position": {
                "x": 100,
                "y": 310
            }
        },
        {
            "id": "transcribe",
            "type": "SPEECH_TO_TEXT",
            "label": "Yazıya Dök",
            "config": {
                "language": "tr",
                "variableName": "transcription",
                "audioUri": "{{callRecording}}"
            },
            "position": {
                "x": 100,
                "y": 440
            }
        },
        {
            "id": "summarize",
            "type": "AGENT_AI",
            "label": "Özet Çıkar",
            "config": {
                "model": "gemini-2.5-flash",
                "systemPrompt": "Sen bir telefon görüşmesi analiz uzmanısın. Görevin verilen dökümü analiz edip özet çıkarmaktır. ASLA kullanıcıya soru sorma, ASLA JSON formatı kullanma. Sadece düz metin olarak şunları yaz:\n\n1. Görüşmenin kısa özeti (2-3 cümle)\n2. Konuşulan önemli konular (madde madde)\n3. Varsa belirtilen tarihler, saatler veya randevular\n4. Varsa karar alınan veya söz verilen işler\n\nEğer döküm çok kısa veya anlaşılmaz ise, bunu belirt ve eldeki bilgiyle özet çıkar.",
                "prompt": "Arayan: {{callerInfo}}\nTarih: {{_date}}, Saat: {{_time}}\n\nGörüşme Dökümü:\n{{transcription}}",
                "variableName": "summary",
                "preventAskUser": true,
                "maxTokens": 1024
            },
            "position": {
                "x": 100,
                "y": 570
            }
        },
        {
            "id": "save_memory",
            "type": "ADD_TO_MEMORY",
            "label": "Hafızaya Kaydet",
            "config": {
                "text": "📞 ARAMA KAYDI - {{_date}} {{_time}}\nArayan: {{callerInfo}}\n\n{{summary}}",
                "metadata": "{\"type\":\"call_recording\",\"caller\":\"{{callerInfo}}\",\"date\":\"{{_date}}\",\"time\":\"{{_time}}\"}"
            },
            "position": {
                "x": 100,
                "y": 700
            }
        },
        {
            "id": "notify_user",
            "type": "NOTIFICATION",
            "label": "Bildir",
            "config": {
                "type": "push",
                "title": "📞 Görüşme Kaydedildi",
                "message": "{{callerInfo}} ile yapılan görüşme özetlendi ve hafızaya kaydedildi."
            },
            "position": {
                "x": 100,
                "y": 830
            }
        }
    ],
    "edges": [
        {
            "id": "e1",
            "source": "trigger_call_end",
            "target": "delay_wait",
            "sourcePort": "default",
            "targetPort": "input"
        },
        {
            "id": "e2",
            "source": "delay_wait",
            "target": "find_recording",
            "sourcePort": "default",
            "targetPort": "input"
        },
        {
            "id": "e3",
            "source": "find_recording",
            "target": "transcribe",
            "sourcePort": "default",
            "targetPort": "input"
        },
        {
            "id": "e4",
            "source": "transcribe",
            "target": "summarize",
            "sourcePort": "default",
            "targetPort": "input"
        },
        {
            "id": "e5",
            "source": "summarize",
            "target": "save_memory",
            "sourcePort": "default",
            "targetPort": "input"
        },
        {
            "id": "e6",
            "source": "save_memory",
            "target": "notify_user",
            "sourcePort": "default",
            "targetPort": "input"
        }
    ]
}
{
  "name": "Slack Node Test (Send + Read)",
  "description": "Sends a Slack message with SLACK_SEND, waits 5s, then reads newer channel messages via conversations.history.",
  "category": "communication",
  "icon": "logo-slack",
  "color": "#4A154B",
  "nodes": [
    {
      "id": "trigger-1",
      "type": "MANUAL_TRIGGER",
      "label": "Başlat",
      "config": {},
      "position": {
        "x": 220,
        "y": 60
      }
    },
    {
      "id": "input-token",
      "type": "TEXT_INPUT",
      "label": "1) Bot Token",
      "config": {
        "prompt": "Slack Bot Token (xoxb-...) girin:",
        "variableName": "slack_bot_token"
      },
      "position": {
        "x": 220,
        "y": 180
      }
    },
    {
      "id": "input-channel",
      "type": "TEXT_INPUT",
      "label": "2) Channel ID",
      "config": {
        "prompt": "Slack Channel ID (Örn: C12345678) girin:",
        "variableName": "slack_channel"
      },
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "input-message",
      "type": "TEXT_INPUT",
      "label": "3) Mesaj",
      "config": {
        "prompt": "Gönderilecek mesajı girin:",
        "variableName": "slack_message"
      },
      "position": {
        "x": 220,
        "y": 420
      }
    },
    {
      "id": "slack-send-1",
      "type": "SLACK_SEND",
      "label": "Slack Mesajı Gönder",
      "config": {
        "mode": "bot",
        "apiToken": "{{slack_bot_token}}",
        "channel": "{{slack_channel}}",
        "message": "{{slack_message}}",
        "apiUrl": "https://slack.com/api/chat.postMessage",
        "variableName": "slack_send_result"
      },
      "position": {
        "x": 220,
        "y": 540
      }
    },
    {
      "id": "delay-1",
      "type": "DELAY",
      "label": "5 Saniye Bekle",
      "config": {
        "duration": 5,
        "unit": "sec"
      },
      "position": {
        "x": 220,
        "y": 660
      }
    },
    {
      "id": "http-read-1",
      "type": "HTTP_REQUEST",
      "label": "Kanaldan Yanıtları Oku",
      "config": {
        "url": "https://slack.com/api/conversations.history",
        "method": "GET",
        "variableName": "slack_history_result",
        "timeout": 30000,
        "queryParameters": {
          "channel": "{{slack_channel}}",
          "oldest": "{{slack_send_result.ts}}",
          "inclusive": "false",
          "limit": "1"
        },
        "authentication": {
          "type": "bearer",
          "token": "{{slack_bot_token}}"
        }
      },
      "position": {
        "x": 220,
        "y": 780
      }
    },
    {
      "id": "show-result",
      "type": "SHOW_TEXT",
      "label": "Sonucu Göster",
      "config": {
        "title": "Slack Gönderim ve Okuma Sonucu",
        "content": "Send success: {{slack_send_result.success}}\nPost API ok: {{slack_send_result.response.ok}}\nPost ts: {{slack_send_result.ts}}\n\nRead HTTP ok: {{slack_history_result.ok}}\nRead API data ok: {{slack_history_result.data.ok}}\nNew msg count: {{slack_history_result.data.messages.length}}\nLatest text: {{slack_history_result.data.messages[0].text}}"
      },
      "position": {
        "x": 220,
        "y": 900
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "trigger-1",
      "targetNodeId": "input-token",
      "sourcePort": "default"
    },
    {
      "id": "e2",
      "sourceNodeId": "input-token",
      "targetNodeId": "input-channel",
      "sourcePort": "default"
    },
    {
      "id": "e3",
      "sourceNodeId": "input-channel",
      "targetNodeId": "input-message",
      "sourcePort": "default"
    },
    {
      "id": "e4",
      "sourceNodeId": "input-message",
      "targetNodeId": "slack-send-1",
      "sourcePort": "default"
    },
    {
      "id": "e5",
      "sourceNodeId": "slack-send-1",
      "targetNodeId": "delay-1",
      "sourcePort": "default"
    },
    {
      "id": "e5b",
      "sourceNodeId": "slack-send-1",
      "targetNodeId": "show-result",
      "sourcePort": "error"
    },
    {
      "id": "e6",
      "sourceNodeId": "delay-1",
      "targetNodeId": "http-read-1",
      "sourcePort": "default"
    },
    {
      "id": "e7",
      "sourceNodeId": "http-read-1",
      "targetNodeId": "show-result",
      "sourcePort": "default"
    },
    {
      "id": "e8",
      "sourceNodeId": "http-read-1",
      "targetNodeId": "show-result",
      "sourcePort": "error"
    }
  ]
}